---
import Layout from "@/components/Layout.astro";
import AgencyWall from "@/components/AgencyWall.astro";
import AgencyFinder from "@/islands/AgencyFinder.svelte";
import AgencyQuestions from "@/islands/AgencyQuestions.svelte";
import { getAgencies } from "@/lib/load";
import { getStatements } from "@/lib/statements";
import { AGENCY_QUESTIONS, agencyAnswers } from "@/lib/questions";
import { SIZE_LABEL, originalityPercent, formatDate } from "@/lib/format";
import { statementPath, withBase } from "@/lib/paths";

const agencies = await getAgencies();
const byName = (a: { name: string }, b: { name: string }) => a.name.localeCompare(b.name);
const published = agencies.filter((a) => a.status === "published").toSorted(byName);
const notYet = agencies.filter((a) => a.status === "not-yet").toSorted(byName);
// Silent bodies split by what the policy asks of them: a corporate entity that
// never published is a different thing from one the policy carves out entirely.
const silent = agencies.filter((a) => a.status === "exempt");
const voluntary = silent.filter((a) => a.scope === "voluntary").toSorted(byName);
const carvedOut = silent.filter((a) => a.scope === "exempt").toSorted(byName);
const mandatoryCount = agencies.filter((a) => a.scope === "mandatory").length;
const finderAgencies = agencies.map((a) => ({ abbr: a.abbr, name: a.name, status: a.status }));

// Each published statement's answers to the reader's questions, and how many
// of the Standard's eight elements it covers.
const docs = await getStatements();
const rows = published.map((a) => {
  const doc = a.statementId ? docs[a.statementId] : undefined;
  const standard = doc?.standard ? Object.values(doc.standard) : null;
  return {
    agency: a,
    answers: agencyAnswers(a, doc),
    standard: standard ? `${standard.filter(Boolean).length} of ${standard.length}` : null,
  };
});
const questions = AGENCY_QUESTIONS.map((q) => ({
  ...q,
  count: rows.filter((r) => r.answers.includes(q.key)).length,
})).filter((q) => q.count > 0);
---

<Layout
  title="Agencies"
  description={`Which of the ${agencies.length} tracked Australian Government bodies have published an AI transparency statement, which haven't, and which aren't required to.`}
>
  <div class="page stack">
    <header class="stack">
      <h1>Agencies</h1>
      <p class="lede">
        All {agencies.length} bodies we track. The <a
          href="https://www.digital.gov.au/ai/ai-in-government-policy/implementation"
          >AI policy applies</a
        > to non-corporate Commonwealth entities ({mandatoryCount} of those listed here),
        and each must publish an <a
          href="https://www.digital.gov.au/ai/ai-in-government-policy/standard-ai-transparency-statements"
          >AI transparency statement</a
        >. Other bodies are encouraged to publish, and many do. Defence and the
        intelligence agencies are exempt.
      </p>
    </header>

    <AgencyFinder client:load agencies={finderAgencies} label="Jump to an agency" />

    <AgencyWall />

    <section>
      <div class="section-title">
        <h2>Published</h2>
        <span class="muted">{published.length}</span>
      </div>
      <AgencyQuestions client:load questions={questions} total={published.length} />
      <div class="table-wrap">
        <table class="agencies">
          <caption class="visually-hidden">Agencies with a published AI transparency statement</caption>
          <thead>
            <tr>
              <th scope="col">Agency</th>
              <th scope="col">Size</th>
              <th scope="col" class="num">Standard</th>
              <th scope="col" class="num">Bespoke</th>
              <th scope="col" class="num"><a href={withBase("/reading#changes")}>Changes</a></th>
              <th scope="col" class="num">Versions</th>
              <th scope="col"><a href={withBase("/reading#adoption")}>Since policy v2.0</a></th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map(({ agency: a, answers, standard }) => (
                <tr data-answers={answers.join(" ")}>
                  <td>
                    <a href={statementPath(a.abbr)}>{a.name}</a>
                    <span class="muted mono"> {a.abbr}</span>
                  </td>
                  <td>{SIZE_LABEL[a.size]}</td>
                  <td class="num">{standard ?? "—"}</td>
                  <td class="num">
                    {a.originality === null ? "—" : `${originalityPercent(a.originality)}%`}
                  </td>
                  <td class="num">{a.changeCount}</td>
                  <td class="num">{a.revisionCount}</td>
                  <td>
                    {a.currency?.updatedSincePolicyV2 === true ? (
                      <span class="pill pill--ok">updated</span>
                    ) : a.currency?.updatedSincePolicyV2 === false ? (
                      <span class="muted">none seen</span>
                    ) : (
                      <span
                        class="muted"
                        title="First tracked after 15 December 2025 and gives no date, so we cannot know"
                      >
                        can&rsquo;t tell
                      </span>
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    {
      notYet.length > 0 && (
        <section>
          <div class="section-title">
            <h2>Not yet published</h2>
            <span class="muted">{notYet.length}</span>
          </div>
          <p class="section-note">
            Bodies that must publish but have no statement we can find, or whose
            statement we couldn&rsquo;t capture on the latest run. Bodies created after
            the policy took effect show when they were established.
          </p>
          <ul class="agency-list">
            {notYet.map((a) => (
              <li>
                {a.name} <span class="muted mono">{a.abbr}</span>
                {a.established && (
                  <span class="muted">, established {formatDate(a.established)}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      voluntary.length > 0 && (
        <section>
          <div class="section-title">
            <h2>Not required to publish</h2>
            <span class="muted">{voluntary.length}</span>
          </div>
          <p class="section-note">
            Bodies the policy encourages but doesn&rsquo;t require to publish, which
            haven&rsquo;t. Those that have are listed under Published, and on the
            DTA&rsquo;s{" "}
            <a href="https://www.digital.gov.au/policy/ai/list-of-transparency-statements">
              register
            </a>
            .
          </p>
          <ul class="agency-list">
            {voluntary.map((a) => (
              <li>
                {a.name} <span class="muted mono">{a.abbr}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      carvedOut.length > 0 && (
        <section>
          <div class="section-title">
            <h2>Exempt</h2>
            <span class="muted">{carvedOut.length}</span>
          </div>
          <p class="section-note">
            The policy{" "}
            <a href="https://www.digital.gov.au/ai/ai-in-government-policy/implementation">
              doesn&rsquo;t apply
            </a>{" "}
            to the defence portfolio or the national intelligence community (section 4
            of the <cite>Office of National Intelligence Act 2018</cite>). These exempt
            bodies haven&rsquo;t published; those that have are listed under Published.
          </p>
          <ul class="agency-list">
            {carvedOut.map((a) => (
              <li>
                {a.name} <span class="muted mono">{a.abbr}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Layout>

<style>
  .agencies {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .agencies th {
    text-align: start;
    font-weight: 600;
    color: var(--muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--border);
  }

  .agencies td {
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--border);
    vertical-align: baseline;
  }

  .agencies .num {
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  .agencies :is(th, td) + :is(th, td) {
    padding-inline-start: var(--space-4);
  }

  .section-note {
    color: var(--muted);
    max-width: 44rem;
    margin-block: calc(-1 * var(--space-2)) var(--space-4);
    font-size: 0.92rem;
  }

  .agency-list {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 18rem 2;
    gap: var(--space-5);
  }

  .agency-list li {
    padding-block: var(--space-1);
    break-inside: avoid;
  }
</style>
