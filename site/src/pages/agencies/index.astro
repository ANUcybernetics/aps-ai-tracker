---
import Layout from "@/components/Layout.astro";
import AgencyWall from "@/components/AgencyWall.astro";
import AgencyFinder from "@/islands/AgencyFinder.svelte";
import { getAgencies } from "@/lib/load";
import { SIZE_LABEL, originalityPercent } from "@/lib/format";
import { statementPath } from "@/lib/paths";

const agencies = await getAgencies();
const byName = (a: { name: string }, b: { name: string }) => a.name.localeCompare(b.name);
const published = agencies.filter((a) => a.status === "published").toSorted(byName);
const notYet = agencies.filter((a) => a.status === "not-yet").toSorted(byName);
// Silent bodies split by what the policy asks of them: a corporate entity that
// never published is a different thing from one the policy carves out entirely.
const silent = agencies.filter((a) => a.status === "exempt");
const voluntary = silent.filter((a) => a.scope === "voluntary").toSorted(byName);
const carvedOut = silent.filter((a) => a.scope === "exempt").toSorted(byName);
const mandatoryCount = agencies.filter((a) => a.scope === "mandatory").length;
const finderAgencies = agencies.map((a) => ({ abbr: a.abbr, name: a.name, status: a.status }));
---

<Layout
  title="Agencies"
  description={`Which of the ${agencies.length} tracked Australian Government bodies have published an AI transparency statement, which haven't, and which sit outside the mandate.`}
>
  <div class="page stack">
    <header class="stack">
      <h1>Agencies</h1>
      <p class="lede">
        All {agencies.length} bodies we track. The Policy for the responsible use of
        AI in government <a
          href="https://www.digital.gov.au/ai/ai-in-government-policy/implementation"
          >applies to non-corporate Commonwealth entities</a
        > &mdash; {mandatoryCount} of these &mdash; and each must publish an <a
          href="https://www.digital.gov.au/ai/ai-in-government-policy/standard-ai-transparency-statements"
          >AI transparency statement</a
        >. Corporate Commonwealth entities are encouraged rather than required to,
        and the defence portfolio and national intelligence community are carved out
        altogether. We track the rest anyway, because plenty publish regardless.
      </p>
    </header>

    <AgencyFinder client:load agencies={finderAgencies} label="Jump to an agency" />

    <AgencyWall />

    <section>
      <div class="section-title">
        <h2>Published</h2>
        <span class="muted">{published.length}</span>
      </div>
      <table class="agencies">
        <caption class="visually-hidden">Agencies with a published AI transparency statement</caption>
        <thead>
          <tr>
            <th scope="col">Agency</th>
            <th scope="col">Size</th>
            <th scope="col" class="num">Bespoke</th>
            <th scope="col" class="num">Changes</th>
            <th scope="col">Since policy 2.0</th>
          </tr>
        </thead>
        <tbody>
          {
            published.map((a) => (
              <tr>
                <td>
                  <a href={statementPath(a.abbr)}>{a.name}</a>
                  <span class="muted mono"> {a.abbr}</span>
                </td>
                <td>{SIZE_LABEL[a.size]}</td>
                <td class="num">
                  {a.originality === null ? "—" : `${originalityPercent(a.originality)}%`}
                </td>
                <td class="num">{a.revisionCount}</td>
                <td>
                  {a.currency?.updatedSincePolicyV2 ? (
                    <span class="pill pill--ok">updated</span>
                  ) : (
                    <span class="muted">no sign</span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    {
      notYet.length > 0 && (
        <section>
          <div class="section-title">
            <h2>Not yet published</h2>
            <span class="muted">{notYet.length}</span>
          </div>
          <p class="section-note">
            Bodies that owe a statement and have none we can find &mdash; or whose
            statement we hold a link for but failed to capture on the latest run.
          </p>
          <ul class="agency-list">
            {notYet.map((a) => (
              <li>
                {a.name} <span class="muted mono">{a.abbr}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      voluntary.length > 0 && (
        <section>
          <div class="section-title">
            <h2>Publication voluntary</h2>
            <span class="muted">{voluntary.length}</span>
          </div>
          <p class="section-note">
            Corporate Commonwealth entities and bodies outside the PGPA list. The
            policy encourages them to publish but does not require it, and these
            ones have not. Many of their peers did publish anyway, and appear under
            Published above and among the DTA&rsquo;s{" "}
            <a href="https://www.digital.gov.au/policy/ai/list-of-transparency-statements">
              voluntary statements
            </a>
            .
          </p>
          <ul class="agency-list">
            {voluntary.map((a) => (
              <li>
                {a.name} <span class="muted mono">{a.abbr}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      carvedOut.length > 0 && (
        <section>
          <div class="section-title">
            <h2>Carved out of the policy</h2>
            <span class="muted">{carvedOut.length}</span>
          </div>
          <p class="section-note">
            The policy{" "}
            <a href="https://www.digital.gov.au/ai/ai-in-government-policy/implementation">
              does not apply
            </a>{" "}
            to AI use in the defence portfolio, or to the national intelligence
            community as defined in section 4 of the <cite>Office of National
            Intelligence Act 2018</cite>. Carve-outs may still publish voluntarily,
            and several have.
          </p>
          <ul class="agency-list">
            {carvedOut.map((a) => (
              <li>
                {a.name} <span class="muted mono">{a.abbr}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Layout>

<style>
  .agencies {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .agencies th {
    text-align: start;
    font-weight: 600;
    color: var(--muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--border);
  }

  .agencies td {
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--border);
    vertical-align: baseline;
  }

  .agencies .num {
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  .section-note {
    color: var(--muted);
    max-width: 44rem;
    margin-block: calc(-1 * var(--space-2)) var(--space-4);
    font-size: 0.92rem;
  }

  .agency-list {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 18rem 2;
    gap: var(--space-5);
  }

  .agency-list li {
    padding-block: var(--space-1);
    break-inside: avoid;
  }
</style>
