---
import Layout from "@/components/Layout.astro";
import StatementMeta from "@/components/StatementMeta.astro";
import StatementBody from "@/components/StatementBody.astro";
import OriginalityBadge from "@/components/OriginalityBadge.astro";
import ProfileCard from "@/components/ProfileCard.astro";
import StoryList from "@/components/StoryList.astro";
import RevisionList from "@/components/RevisionList.astro";
import RevisionScrubber from "@/components/RevisionScrubber.astro";
import ReadingLink from "@/components/ReadingLink.astro";
import { documentUri } from "@/lib/atproto";
import { getAllStatements } from "@/lib/statements";
import { meta, propagation, getAgencyNames } from "@/lib/load";
import { formatDate } from "@/lib/format";
import { revisionBodyToHtml } from "@/lib/markdown";
import { changeTier } from "@/lib/profile-labels";
import { buildScrubberDots, revAnchor, timePercent } from "@/lib/scrubber";
import type { StatementDoc } from "@/types/exporter";

export async function getStaticPaths() {
  const allStatements = await getAllStatements();
  return allStatements.map((doc) => ({ params: { abbr: doc.abbr }, props: { doc } }));
}

interface Props {
  doc: StatementDoc;
}

const { doc } = Astro.props;
const names = await getAgencyNames();
const isUrsource = doc.abbr === propagation.ursource;
const firstSeen = doc.timeline[0]?.date;
// "Changes" counts only changes of substance: the exporter classifies every
// revision from its diff, and noise and cosmetic edits are not changes to what
// the statement says.
const contentChanges = doc.timeline.filter((t) => changeTier(t.changeKind) === "content");
const changes = contentChanges.length;
const lastUpdated = contentChanges.at(-1)?.date;

// For each shared passage, the other agencies that carry it (matched by normKey
// to a propagation cluster), so a highlighted passage can name its company.
const sharedBy: Record<string, { abbr: string; name: string }[]> = {};
for (const cluster of propagation.clusters) {
  const others = cluster.memberAbbrs
    .filter((abbr) => abbr !== doc.abbr)
    .map((abbr) => ({ abbr, name: names[abbr] ?? abbr }));
  if (others.length) sharedBy[cluster.normKey] = others;
}

// Scrubber axis: corpus start → build date, shared by every statement page so
// agencies are visually comparable; the pre-tracking region renders faint.
const axisStart = meta.corpusStart ?? firstSeen ?? meta.builtAt;
const axisEnd = meta.builtAt;
const dots = buildScrubberDots(doc.timeline, axisStart, axisEnd);
const firstSeenPct = firstSeen ? timePercent(firstSeen, axisStart, axisEnd) : 0;

// Historical revisions, pre-rendered at build time for the scrubber's
// time-travel (the newest revision is the current statement above).
const historical = doc.timeline.slice(0, -1).map((rev) => ({
  anchor: revAnchor(rev.sha),
  html: revisionBodyToHtml(rev.body),
}));

// The scrubber treats the newest timeline revision as "the current statement"
// (rendered via StatementBody with passage heat, not a hidden body). The
// exporter's revert collapsing is whitespace-loose (_body_key in export.py) —
// a whitespace-only reformat commit is dropped from the timeline — so compare
// the same way, and fail the build loudly on real drift.
const collapseWs = (s: string) => s.replace(/\s+/g, " ").trim();
const newest = doc.timeline.at(-1);
if (!newest || collapseWs(newest.body) !== collapseWs(doc.body)) {
  throw new Error(
    `${doc.abbr}: newest timeline revision does not match the current statement body — ` +
      "the scrubber's current-revision dot would misrepresent it",
  );
}

const legend = [
  { heat: 1, label: "a few" },
  { heat: 2, label: "several" },
  { heat: 3, label: "many" },
  { heat: 4, label: "most" },
];
---

<Layout
  title={doc.agency}
  description={`How ${doc.agency} describes its use of AI — what its statement commits to, how that has changed, and the text itself.`}
  atUri={documentUri(doc.abbr)}
>
  <div class="page stmt stack">
    <header class="stmt__header stack">
      <p class="stmt__abbr mono muted">{doc.abbr}</p>
      <h1>{doc.agency}</h1>
      <StatementMeta doc={doc} />
      <p class="muted stmt__dates">
        {firstSeen && <>Tracked since {formatDate(firstSeen)}</>}
        {" · "}{changes} {changes === 1 ? "change" : "changes"} of substance across {doc.timeline.length}{" "}
        {doc.timeline.length === 1 ? "capture" : "captures"}
        {lastUpdated && <> · last changed {formatDate(lastUpdated)}</>}
      </p>
      {
        doc.latestCaptureSuspect && (
          <p class="stmt__notice">
            Our latest capture of this page lost most of its text and has been held back as a
            likely scraping failure, so the statement shown here is the last complete capture.{" "}
            <a href={doc.finalUrl ?? doc.sourceUrl ?? "#"}>Check the agency&rsquo;s page</a> for the current text.
          </p>
        )
      }
    </header>

    <section class="stmt__section" aria-labelledby="story-heading">
      <div class="section-title">
        <h2 id="story-heading">The story so far</h2>
        <ReadingLink anchor="changes" />
      </div>
      <StoryList timeline={doc.timeline} currency={doc.currency} agency={doc.agency} />
    </section>

    {
      doc.profile && doc.standard && (
        <section class="stmt__section" aria-labelledby="profile-heading">
          <div class="section-title">
            <h2 id="profile-heading">What the statement says</h2>
            <ReadingLink anchor="profiles" />
          </div>
          <ProfileCard
            profile={doc.profile}
            standard={doc.standard}
            currency={doc.currency}
            model={doc.profileModel}
          />
        </section>
      )
    }

    <div class="stmt__grid">
      <article class="stmt__main" id="statement">
        <div class="section-title">
          <h2>The statement</h2>
        </div>
        <div data-rev-current>
          <div class="heat-legend">
            <div class="heat-legend__items" aria-hidden="true">
              <span>Reused by agencies:</span>
              {
                legend.map((l) => (
                  <span>
                    <span class="heat-legend__swatch" data-heat={l.heat} /> {l.label}
                  </span>
                ))
              }
              <span class="heat-legend__sep">
                <span class="heat-legend__swatch" data-variant="template" /> template wording
              </span>
            </div>
            <ReadingLink anchor="reuse" />
          </div>
          <StatementBody passages={doc.passages} sharedBy={sharedBy} />
        </div>
        {
          historical.map((rev) => (
            <section
              class="prose rev-body"
              data-rev-body={rev.anchor}
              hidden
              set:html={rev.html}
            />
          ))
        }
        <p class="muted stmt__attribution">
          Statement text &copy; {doc.agency}, reproduced for transparency tracking
          (most agency content is CC BY 4.0 &mdash; check the original for specifics).
        </p>
      </article>

      <aside class="stmt__aside stack">
        <section class="card">
          <h2>Originality</h2>
          <OriginalityBadge originality={doc.originality} isUrsource={isUrsource} />
          <ReadingLink anchor="originality" class="card__how" />
        </section>
      </aside>
    </div>

    <section class="stmt__history">
      <div class="section-title">
        <h2>Every revision</h2>
      </div>
      <p class="muted stmt__history-note">
        Every capture the daily scrape recorded that differed from the last, including
        edits with no change of substance. Pick a dot to view the statement as it stood
        at that capture.
      </p>
      <RevisionScrubber dots={dots} axisStart={axisStart} firstSeenPct={firstSeenPct} />
      <RevisionList timeline={doc.timeline} />
    </section>
  </div>
</Layout>

<style>
  .stmt__abbr {
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }

  .stmt__header h1 {
    margin: 0;
  }

  .stmt__dates {
    font-size: 0.9rem;
  }

  .stmt__notice {
    margin: 0;
    max-inline-size: var(--measure);
    padding: var(--space-3);
    border-inline-start: 3px solid var(--accent);
    background: var(--accent-wash);
    font-size: var(--text-sm);
  }

  .stmt__section {
    margin-block-start: var(--space-4);
  }

  .stmt__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    margin-block-start: var(--space-4);
  }

  @media (width >= 60rem) {
    .stmt__grid {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }

    .stmt__aside {
      position: sticky;
      top: 4.5rem;
      /* clear the section heading in the main column */
      margin-block-start: 3.2rem;
    }
  }

  .heat-legend [data-heat="1"] {
    background: var(--heat-1);
  }
  .heat-legend [data-heat="2"] {
    background: var(--heat-2);
  }
  .heat-legend [data-heat="3"] {
    background: var(--heat-3);
  }
  .heat-legend [data-heat="4"] {
    background: var(--heat-4);
  }
  .heat-legend [data-variant="template"] {
    background: var(--template-wash);
  }

  /* set the template swatch apart from the amber-ramp items */
  .heat-legend__sep {
    padding-inline-start: var(--space-3);
    border-inline-start: 1px solid var(--border);
  }

  .heat-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-block-end: var(--space-4);
  }

  .heat-legend__items {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .stmt__aside h2 {
    margin-block: 0 var(--space-3);
    font-size: 1rem;
  }

  .card__how {
    display: inline-block;
    margin-block-start: var(--space-3);
  }

  .stmt__attribution {
    margin-block-start: var(--space-6);
    font-size: 0.8rem;
    border-top: 1px solid var(--border);
    padding-block-start: var(--space-3);
  }

  .stmt__history {
    margin-block-start: var(--space-4);
  }

  .stmt__history-note {
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    max-inline-size: var(--measure);
  }
</style>
