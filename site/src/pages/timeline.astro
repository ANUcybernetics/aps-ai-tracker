---
import Layout from "@/components/Layout.astro";
import ChangeFeedItem from "@/components/ChangeFeedItem.astro";
import ReadingLink from "@/components/ReadingLink.astro";
import TimelineFilter from "@/islands/TimelineFilter.svelte";
import { getAgencies, getTimeline } from "@/lib/load";
import { monthlyMix } from "@/lib/monthly";
import { changeTier } from "@/lib/profile-labels";
import { getStatements } from "@/lib/statements";
import type { TimelineEvent } from "@/types/exporter";

const timeline = await getTimeline();
const statements = await getStatements();
const agencies = await getAgencies();

// Join each event to its statement's revision history to compute the diff
// against the previous revision (build-time; only rendered diff HTML ships).
function diffFor(event: TimelineEvent) {
  const stmt = statements[event.statementId];
  if (!stmt) return null;
  const idx = stmt.timeline.findIndex((t) => t.sha === event.sha);
  if (idx <= 0) return null; // first-seen events have nothing to diff against
  const prev = stmt.timeline[idx - 1];
  const curr = stmt.timeline[idx];
  return { before: prev.body, after: curr.body, delta: curr.charDelta };
}

const portfolioByAbbr = new Map(agencies.map((a) => [a.abbr, a.portfolio]));
const rows = timeline.map((event) => ({
  event,
  diff: diffFor(event),
  portfolio: portfolioByAbbr.get(event.abbr) ?? null,
}));

const agencyOpts = [...new Map(timeline.map((e) => [e.abbr, e.agency])).entries()]
  .map(([abbr, name]) => ({ abbr, name }))
  .sort((a, b) => a.name.localeCompare(b.name));

const portfolios = [
  ...new Set(rows.map((r) => r.portfolio).filter((p): p is string => Boolean(p))),
].sort((a, b) => a.localeCompare(b));

const chart = monthlyMix(timeline);

const tiers = timeline.map((e) => changeTier(e.changeKind));
const counts = {
  content: tiers.filter((t) => t === "content").length,
  cosmetic: tiers.filter((t) => t === "cosmetic").length,
  noise: tiers.filter((t) => t === "noise").length,
  first: tiers.filter((t) => t === "first").length,
};
---

<Layout
  title="Timeline"
  description="Every change of substance to every Australian Government AI transparency statement, newest first, each summarised in a sentence."
>
  <div class="page stack">
    <header class="stack">
      <h1>Timeline</h1>
      <p class="lede">
        Every change of substance the daily scrape has recorded, newest first, each
        read from the diff and summarised in a sentence. Cosmetic edits ({counts.cosmetic}),
        scrape noise ({counts.noise}) and first-tracked captures ({counts.first}) are hidden
        until you ask for them. Narrow the feed by agency, portfolio or kind of change,
        click a month in the chart, or search &mdash; the search reads the words that
        changed, not just the summaries. Open a row to see the words that moved.
      </p>
      <p class="muted">
        Summaries are written by a language model from the diff; each row shows which
        one, and &ldquo;the words that changed&rdquo; is always the primary source.
      </p>
      <ReadingLink anchor="changes" label="How changes are classified" />
    </header>

    <TimelineFilter
      client:load
      agencies={agencyOpts}
      portfolios={portfolios}
      chart={chart}
      total={counts.content}
    />

    <ul class="tl-feed" id="tl-feed">
      {
        rows.map(({ event, diff, portfolio }) => (
          <ChangeFeedItem event={event} diff={diff} portfolio={portfolio} />
        ))
      }
    </ul>
  </div>
</Layout>

<style>
  /* The row styles live in ChangeFeedItem.astro, which owns the <li> markup —
     keeping them here would scope them to this page's id, which the rows (a
     child component) don't carry, so none of them would actually apply. */
  .tl-feed {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
