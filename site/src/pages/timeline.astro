---
import Layout from "@/components/Layout.astro";
import ChangeFeedItem from "@/components/ChangeFeedItem.astro";
import ReadingLink from "@/components/ReadingLink.astro";
import TimelineFilter from "@/islands/TimelineFilter.svelte";
import { getAgencies, getTimeline } from "@/lib/load";
import { monthlyMix } from "@/lib/monthly";
import { REQUIREMENTS, changeTier } from "@/lib/profile-labels";
import { changeFacets } from "@/lib/questions";
import { withBase } from "@/lib/paths";
import { getStatements } from "@/lib/statements";
import type { TimelineEvent } from "@/types/exporter";

const timeline = await getTimeline();
const statements = await getStatements();
const agencies = await getAgencies();

// Join each event to its statement's revision history: the diff against the
// previous revision (build-time; only rendered diff HTML ships) and the
// answers the revision changed.
function revisionFor(event: TimelineEvent) {
  const stmt = statements[event.statementId];
  const idx = stmt ? stmt.timeline.findIndex((t) => t.sha === event.sha) : -1;
  return idx < 0 ? null : { stmt, idx };
}

function diffFor(event: TimelineEvent) {
  const found = revisionFor(event);
  if (!found || found.idx === 0) return null; // first-seen events have nothing to diff against
  const prev = found.stmt.timeline[found.idx - 1];
  const curr = found.stmt.timeline[found.idx];
  return { before: prev.body, after: curr.body, delta: curr.charDelta };
}

const agencyByAbbr = new Map(agencies.map((a) => [a.abbr, a]));
const rows = timeline.map((event) => {
  const found = revisionFor(event);
  const deltas = found ? found.stmt.timeline[found.idx].profileDeltas : [];
  return {
    event,
    diff: diffFor(event),
    portfolio: agencyByAbbr.get(event.abbr)?.portfolio ?? null,
    scope: agencyByAbbr.get(event.abbr)?.scope ?? null,
    deltas,
    facets: changeFacets({ profileDeltas: deltas }),
  };
});

// The "about" filter lists only requirements some change actually touched.
const touched = new Map<string, number>();
for (const r of rows) {
  for (const k of new Set(r.facets.map((f) => f.split(":")[0]))) touched.set(k, (touched.get(k) ?? 0) + 1);
}
const requirementOpts = REQUIREMENTS.filter((r) => touched.has(r.key)).map((r) => ({
  key: r.key,
  label: r.label,
  source: r.source,
  count: touched.get(r.key) ?? 0,
}));

// Questions to start from, each a link into the filtered feed.
const starters = [
  { label: "Commitments dropped", query: "about=commitments&answers=removed" },
  { label: "Anything dropped", query: "answers=removed" },
  { label: "Chief AI Officers named", query: "about=chief-ai-officer&answers=added" },
  { label: "New uses of AI disclosed", query: "about=classification&answers=added" },
  { label: "Public-facing AI", query: "about=public-facing" },
].map((s) => ({ ...s, href: `${withBase("/timeline")}?${s.query}` }));

const agencyOpts = [...new Map(timeline.map((e) => [e.abbr, e.agency])).entries()]
  .map(([abbr, name]) => ({ abbr, name }))
  .sort((a, b) => a.name.localeCompare(b.name));

const portfolios = [
  ...new Set(rows.map((r) => r.portfolio).filter((p): p is string => Boolean(p))),
].sort((a, b) => a.localeCompare(b));

const chart = monthlyMix(timeline);

const tiers = timeline.map((e) => changeTier(e.changeKind));
const count = (tier: string) => tiers.filter((t) => t === tier).length;
const counts = {
  substance: count("substance"),
  revision: count("revision"),
  unclassified: count("unclassified"),
  cosmetic: count("cosmetic"),
  noise: count("noise"),
  first: count("first"),
};
const readable = counts.substance + counts.revision + counts.unclassified;
---

<Layout
  title="Timeline"
  description="Every change worth reading across every Australian Government AI transparency statement, newest first, each summarised in a sentence."
>
  <div class="page stack">
    <header class="stack">
      <h1>Timeline</h1>
      <p class="lede">
        Every change worth reading, newest first, each summarised in a sentence from its
        diff. There are {counts.substance} substantive changes, where a claim, commitment
        or disclosure was added, removed or altered{
          counts.revision > 0 && (
            <>, and {counts.revision} reworded ones that say the same things differently</>
          )
        }{
          counts.unclassified > 0 && <>, plus {counts.unclassified} not yet read</>
        }. Cosmetic edits ({counts.cosmetic}), noise ({counts.noise}) and first captures
        ({counts.first}) are hidden unless you ask for them. Narrow the feed by the
        question a change touched and whether it added or dropped an answer, by agency,
        portfolio or coverage, or by month in the chart; search covers the changed text,
        and opening a row shows the diff.
      </p>
      <p class="muted">
        A language model writes each summary from the diff, and each row names the model.
        Where a summary and &ldquo;the words that changed&rdquo; disagree, trust the
        words.
      </p>
      <ReadingLink anchor="anatomy" label="Anatomy of a change" />
      <nav class="starters" aria-label="Questions to start from">
        <span class="muted">Start from:</span>
        <ul>
          {starters.map((s) => (
            <li><a href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <TimelineFilter
      client:load
      agencies={agencyOpts}
      portfolios={portfolios}
      requirements={requirementOpts}
      chart={chart}
      total={readable}
    />

    <ul class="tl-feed" id="tl-feed">
      {
        rows.map(({ event, diff, portfolio, scope, deltas, facets }) => (
          <ChangeFeedItem
            event={event}
            diff={diff}
            portfolio={portfolio}
            scope={scope}
            deltas={deltas}
            facets={facets}
          />
        ))
      }
    </ul>
  </div>
</Layout>

<style>
  /* The row styles live in ChangeFeedItem.astro, which owns the <li> markup —
     keeping them here would scope them to this page's id, which the rows (a
     child component) don't carry, so none of them would actually apply. */
  .tl-feed {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .starters {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
  }

  .starters ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .starters a {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
  }

  .starters a:hover {
    border-color: var(--accent);
    color: var(--accent-ink);
  }
</style>
