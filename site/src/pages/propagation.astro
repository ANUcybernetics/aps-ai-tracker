---
import Layout from "@/components/Layout.astro";
import PassageBrowser from "@/islands/PassageBrowser.svelte";
import ReadingLink from "@/components/ReadingLink.astro";
import { propagation, getAgencies, getAgencyNames } from "@/lib/load";
import { statementPath, withBase } from "@/lib/paths";
import { originalityPercent } from "@/lib/format";

const names = await getAgencyNames();
const agencies = await getAgencies();
const portfolioOf = Object.fromEntries(agencies.map((a) => [a.abbr, a.portfolio]));

// Reuse that is not the DTA template: does it run along portfolio lines?
// For every non-template cluster, count the pairs of member agencies that
// share a portfolio versus those that don't, and tally per portfolio the
// passages its members share with one another.
const nonTemplate = propagation.clusters.filter((c) => !c.alsoInDta && c.kind !== "phrase");
let samePortfolioPairs = 0;
let crossPortfolioPairs = 0;
const families = new Map<string, { passages: number; members: Set<string> }>();
for (const c of nonTemplate) {
  const members = c.memberAbbrs.filter((a) => portfolioOf[a]);
  for (let i = 0; i < members.length; i++) {
    for (let j = i + 1; j < members.length; j++) {
      if (portfolioOf[members[i]] === portfolioOf[members[j]]) samePortfolioPairs++;
      else crossPortfolioPairs++;
    }
  }
  const byPortfolio = new Map<string, string[]>();
  for (const a of members) {
    const key = portfolioOf[a]!;
    byPortfolio.set(key, [...(byPortfolio.get(key) ?? []), a]);
  }
  for (const [portfolio, abbrs] of byPortfolio) {
    if (abbrs.length < 2) continue;
    const fam = families.get(portfolio) ?? { passages: 0, members: new Set<string>() };
    fam.passages += 1;
    for (const a of abbrs) fam.members.add(a);
    families.set(portfolio, fam);
  }
}
const familyRows = [...families.entries()]
  .map(([portfolio, f]) => ({ portfolio, passages: f.passages, members: [...f.members].toSorted() }))
  .toSorted((a, b) => b.passages - a.passages || a.portfolio.localeCompare(b.portfolio));
const hasPortfolios = agencies.some((a) => a.portfolio);
const pairTotal = samePortfolioPairs + crossPortfolioPairs;
const board = propagation.originality;
const clusters = propagation.clusters;
const templateClusters = clusters.filter((c) => c.alsoInDta).length;

// Spell out the template source on first mention — a newcomer won't know "DTA".
const ursource = propagation.ursource;
const ursourceName = names[ursource] ?? ursource;
const ursourceLabel = ursourceName === ursource ? ursource : `${ursourceName} (${ursource})`;

const mostBespoke = board.slice(0, 8);
const mostTemplated = board.slice(-8).reverse();

const columns = [
  { heading: "Most bespoke", rows: mostBespoke },
  { heading: "Most templated", rows: mostTemplated },
];
---

<Layout
  title="Propagation"
  description="How a shared template spreads across Australian Government AI transparency statements — an originality leaderboard and a browser of the passages agencies copy."
>
  <div class="page stack">
    <header class="stack">
      <h1>The template effect</h1>
      <p class="lede">
        Agencies reuse one another&rsquo;s wording heavily, and some of it is wording the
        Standard asks for. This shows how much each statement is bespoke versus shared
        with another tracked statement, and lets you browse the exact passages that
        recur: {clusters.length} of them, of which {templateClusters} also appear in the
        {ursourceLabel}&rsquo;s own statement. Sharing says a passage appears in more than
        one place, not who wrote it first.
      </p>
    </header>

    <section>
      <div class="section-title">
        <h2>Originality leaderboard</h2>
        <span class="section-title__links">
          <ReadingLink anchor="originality" />
          <a href={withBase("/agencies")}>All {board.length} ranked &rarr;</a>
        </span>
      </div>
      <div class="boards">
        {
          columns.map((col) => (
            <div class="board">
              <h3 class="board__heading">{col.heading}</h3>
              <ol class="board__list">
                {col.rows.map((e) => (
                  <li class="board__row">
                    <a class="board__name" href={statementPath(e.abbr)}>
                      {names[e.abbr] ?? e.abbr}
                    </a>
                    <span class="board__bar" role="presentation">
                      <span style={`inline-size:${originalityPercent(e.score)}%`} />
                    </span>
                    <span class="board__pct mono">{originalityPercent(e.score)}%</span>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>
    </section>

    {
      hasPortfolios && familyRows.length > 0 && (
        <section>
          <div class="section-title">
            <h2>Reuse within portfolios</h2>
            <span class="muted">{familyRows.length} portfolios</span>
          </div>
          <p class="muted shared-note">
            Set the {ursource} template aside and look at the passages agencies share
            with each other. Of the {pairTotal} pairs of agencies that share such a passage,{" "}
            {samePortfolioPairs} sit in the same portfolio. Shared corporate services, a shared
            ICT provider, or one departmental statement used as the model for its portfolio
            all leave this mark. Passages here, agencies in each family.
          </p>
          <ul class="families">
            {familyRows.map((f) => (
              <li class="family">
                <span class="family__name">{f.portfolio}</span>
                <span class="family__n mono">{f.passages}</span>
                <span class="family__members">
                  {f.members.map((a, i) => (
                    <>
                      {i > 0 && ", "}
                      <a href={statementPath(a)} title={names[a] ?? a}>
                        {a}
                      </a>
                    </>
                  ))}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section>
      <div class="section-title">
        <h2>Shared passages</h2>
        <span class="section-title__links">
          <ReadingLink anchor="reuse" />
          <span class="muted">{clusters.length} clusters</span>
        </span>
      </div>
      <p class="muted shared-note">
        Passages that recur across statements, widest reach first. The {ursource} publishes
        the canonical template, so passages also found there are marked.
      </p>
      <PassageBrowser client:idle names={names} />
    </section>
  </div>
</Layout>

<style>
  .families {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    border-block-start: 1px solid var(--border);
  }

  .family {
    display: grid;
    grid-template-columns: minmax(12rem, 0.4fr) 3rem 1fr;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-2);
    border-block-end: 1px solid var(--border);
    font-size: var(--text-sm);
  }

  .family__name {
    font-weight: 600;
  }

  .family__n {
    color: var(--accent-ink);
    text-align: end;
  }

  .family__members a {
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .family__members a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
  }

  @media (width < 40rem) {
    .family {
      grid-template-columns: 1fr auto;
    }

    .family__members {
      grid-column: 1 / -1;
    }
  }

  .section-title__links {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-4);
  }

  .boards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-5) var(--space-8);
  }

  .board__heading {
    font-size: 1rem;
    margin: 0 0 var(--space-2);
    color: var(--muted);
  }

  .board__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .board__row {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) minmax(4rem, 9rem) 3rem;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-1);
  }

  .board__name {
    color: var(--text);
    text-decoration: none;
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .board__name:hover {
    color: var(--accent-ink);
  }

  /* ink fill (bespoke) on an ochre track (borrowed), so the bar reads itself */
  .board__bar {
    block-size: 0.55rem;
    background: var(--heat-2);
    border-radius: 999px;
    overflow: hidden;
  }

  .board__bar span {
    display: block;
    block-size: 100%;
    background: var(--text);
    border-radius: 999px;
  }

  /* ink-fill / ochre-track encodes the bespoke share; preserve it in forced colours */
  @media (forced-colors: active) {
    .board__bar,
    .board__bar span {
      forced-color-adjust: none;
    }
  }

  .board__pct {
    font-size: 0.8rem;
    color: var(--muted);
    text-align: end;
  }

  .shared-note {
    max-width: var(--measure);
    margin-block-end: var(--space-4);
  }

  @media (width < 34rem) {
    .board__row {
      grid-template-columns: 1fr 3rem;
    }

    .board__bar {
      display: none;
    }
  }
</style>
