---
import { render } from "astro:content";
import Layout from "@/components/Layout.astro";
import { getPublishedNews } from "@/lib/load";
import { formatDate } from "@/lib/format";
import { withBase } from "@/lib/paths";

export async function getStaticPaths() {
  const posts = await getPublishedNews();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.summary}>
  <article class="page prose stack news-post">
    <p class="mono muted news-post__date">
      <a href={withBase("/news")}>News</a> &middot;{" "}
      <time datetime={post.data.date.toISOString().slice(0, 10)}>
        {formatDate(post.data.date.toISOString())}
      </time>
    </p>
    <h1>{post.data.title}</h1>
    <Content />
  </article>
</Layout>

<style>
  .news-post__date {
    margin: 0;
    font-size: var(--text-sm);
  }

  /* A count split into parts: one bar, each segment sized by its number
     (flex-grow set inline in the post's markdown). */
  .news-post :global(.split) {
    margin-block: var(--space-5);
  }

  .news-post :global(.split__bar) {
    display: flex;
    gap: 2px;
  }

  .news-post :global(.split__seg) {
    flex-basis: 0;
    padding: var(--space-2) 0;
    font-weight: 600;
    text-align: center;
  }

  .news-post :global(.split__seg--accent) {
    background: var(--accent);
    color: var(--accent-contrast);
  }

  .news-post :global(.split__seg--ochre) {
    background: var(--accent-ink);
    color: var(--bg);
  }

  .news-post :global(.split__seg--ink) {
    background: var(--text);
    color: var(--bg);
  }

  .news-post :global(.split__seg--grey) {
    background: var(--surface-2);
  }

  .news-post :global(.split__seg--hollow) {
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  .news-post :global(.split figcaption) {
    margin-block-start: var(--space-2);
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
