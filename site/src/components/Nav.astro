---
import { getPublishedNews } from "@/lib/load";
import { withBase } from "@/lib/paths";

// The questions a reader arrives with, then how to read the answers. The
// propagation explorer, who's who and the data downloads keep their URLs and
// are linked from the footer, the overview and the pages that use them.
const links = [
  { href: withBase("/timeline"), label: "Timeline" },
  { href: withBase("/agencies"), label: "Agencies" },
  { href: withBase("/policy"), label: "What the statements say" },
  { href: withBase("/reading"), label: "Reading the data" },
  // News appears once there is a published post to read.
  ...((await getPublishedNews()).length > 0
    ? [{ href: withBase("/news"), label: "News" }]
    : []),
  { href: withBase("/about"), label: "About" },
];

const here = Astro.url.pathname.replace(/\/$/, "");

function isCurrent(href: string): boolean {
  const h = href.replace(/\/$/, "");
  return here === h || here.startsWith(`${h}/`);
}
---

<header class="site-header">
  <div class="page site-header__inner">
    <a class="brand" href={withBase("/")}>APS AI <b>Tracker</b></a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label class="nav-burger" for="nav-toggle" aria-label="Toggle navigation menu">
      <span class="nav-burger__bars" aria-hidden="true"></span>
    </label>
    <nav class="nav" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
