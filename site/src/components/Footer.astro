  <div class="page stack">
    <nav aria-label="More">
      <a href={withBase("/propagation")}>Shared wording</a> &middot;{" "}
      <a href={withBase("/whos-who")}>Who&rsquo;s who</a> &middot;{" "}
      <a href={withBase("/data/")}>Data downloads</a>
    </nav>
    <p>
      A <a href="https://cybernetics.anu.edu.au/cybernetic-studio/"
        >Cybernetic Studio</a
