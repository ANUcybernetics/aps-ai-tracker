---
import DiffView from "@/components/DiffView.astro";
import ModelNote from "@/components/ModelNote.astro";
import { formatDate, signedDelta } from "@/lib/format";
import { CHANGE_KIND_LABEL, changeTier } from "@/lib/profile-labels";
import { statementPath } from "@/lib/paths";
import type { TimelineEvent } from "@/types/exporter";

interface Props {
  event: TimelineEvent;
  diff: { before: string; after: string; delta: number } | null;
}

const { event, diff } = Astro.props;
const tier = changeTier(event.changeKind);
// Content changes are the feed's default view; cosmetic edits, scrape noise
// and first-tracked imports ship hidden and the filter island reveals them.
const hiddenByDefault = tier !== "content";
---

<li
  class="tl-row"
  data-abbr={event.abbr}
  data-kind={event.kind}
  data-tier={tier}
  hidden={hiddenByDefault ? true : undefined}
>
  <div class="tl-row__head">
    <time class="tl-row__date mono" datetime={event.date}>
      {formatDate(event.date)}
    </time>
    <a class="tl-row__agency" href={statementPath(event.abbr)}>{event.agency}</a>
    <span class="pill" data-kind={event.changeKind}>{CHANGE_KIND_LABEL[event.changeKind]}</span>
    {
      diff && (
        <span class="tl-row__delta mono" data-sign={diff.delta >= 0 ? "+" : "-"}>
          {signedDelta(diff.delta)}
        </span>
      )
    }
  </div>
  {event.summary && <p class="tl-row__summary">{event.summary}</p>}
  {event.summary && <ModelNote model={event.model} />}
  {
    event.noteworthy.length > 0 && (
      <ul class="tl-row__points">
        {event.noteworthy.slice(0, 4).map((point) => (
          <li data-removal={point.toLowerCase().startsWith("removed") ? "" : undefined}>{point}</li>
        ))}
      </ul>
    )
  }
  {
    diff && (
      <details class="tl-row__diff">
        <summary>The words that changed</summary>
        <DiffView before={diff.before} after={diff.after} compact />
      </details>
    )
  }
</li>

<style>
  .tl-row {
    border-bottom: 1px solid var(--border);
    padding-block: var(--space-3);
    /* Defer rendering of off-screen rows; remember measured height on re-hide. */
    content-visibility: auto;
    contain-intrinsic-size: auto 72px;
  }

  /* The first rows are above the fold, so exempt them: evaluating containment
     boundaries on the critical paint is the one case where content-visibility
     costs more than it saves. */
  .tl-row:nth-child(-n + 12) {
    content-visibility: visible;
  }

  .tl-row__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }

  .tl-row__date {
    color: var(--muted);
    font-size: 0.85rem;
    min-width: 6.5rem;
  }

  .tl-row__agency {
    font-weight: 550;
    color: var(--text);
    text-decoration: none;
  }

  .tl-row__agency:hover {
    color: var(--accent-ink);
  }

  .tl-row[data-tier="content"] .pill {
    background: var(--accent-wash);
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  .tl-row[data-tier="noise"] .pill {
    border-style: dashed;
    color: var(--muted);
  }

  .tl-row__delta {
    margin-inline-start: auto;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .tl-row__delta[data-sign="+"] {
    color: var(--ok);
  }

  .tl-row__delta[data-sign="-"] {
    color: var(--del-text);
  }

  .tl-row__summary {
    margin: var(--space-2) 0 0;
    max-inline-size: var(--measure);
    text-wrap: pretty;
  }

  .tl-row__points {
    margin: var(--space-2) 0 0;
    padding-inline-start: 1.1rem;
    font-size: var(--text-sm);
    max-inline-size: var(--measure);
  }

  .tl-row__points li[data-removal] {
    color: var(--del-text);
  }

  .tl-row__diff {
    margin-block-start: var(--space-2);
  }

  .tl-row__diff summary {
    cursor: pointer;
    color: var(--muted);
    font-size: 0.85rem;
    width: max-content;
  }
</style>
