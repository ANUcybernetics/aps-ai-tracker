---
import { originalityPercent } from "@/lib/format";
import type { Originality } from "@/types/exporter";

interface Props {
  originality: Originality;
  isUrsource?: boolean;
}

const { originality, isUrsource = false } = Astro.props;
const pct = originalityPercent(originality.score);
const total = originality.shared + originality.unique;
---

<div class="orig">
  <div class="orig__top">
    <span class="orig__pct">{isUrsource ? "Template source" : `${pct}%`}</span>
    <span class="muted">{isUrsource ? "the DTA's template wording" : "bespoke"}</span>
  </div>
  <div class="meter orig__bar" role="presentation">
    <span style={`inline-size:${pct}%`}></span>
  </div>
  <p class="muted">
    {originality.shared} of {total} passages are shared with other agencies.
  </p>
</div>

<style>
  .orig__top {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .orig__pct {
    font-size: 2rem;
    font-weight: 800;
    font-stretch: 90%;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--text);
  }

  .orig__bar {
    margin-block: var(--space-2);
  }

  .orig p {
    font-size: var(--text-sm);
    margin: 0;
  }
</style>
