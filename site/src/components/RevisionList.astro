---
import DiffView from "@/components/DiffView.astro";
import ModelNote from "@/components/ModelNote.astro";
import { formatDate, signedDelta } from "@/lib/format";
import { CHANGE_KIND_LABEL, changeTier } from "@/lib/profile-labels";
import { revAnchor } from "@/lib/scrubber";
import type { TimelineRevision } from "@/types/exporter";

interface Props {
  timeline: TimelineRevision[];
}

const { timeline } = Astro.props;

// Pair each revision with its predecessor, then show newest first.
const revs = timeline
  .map((rev, idx) => ({ rev, prev: idx > 0 ? timeline[idx - 1] : null }))
  .reverse();

const noiseCount = revs.filter((r) => changeTier(r.rev.changeKind) === "noise").length;
---

<div class="revs-wrap">
  {
    noiseCount > 0 && (
      <div class="revs-toggle">
        <input type="checkbox" id="show-noise-revs" />
        <label for="show-noise-revs">
          Include {noiseCount} scrape-noise {noiseCount === 1 ? "revision" : "revisions"} (nothing
          the agency wrote changed)
        </label>
      </div>
    )
  }
  <ol class="revs">
  {
    revs.map(({ rev, prev }) => {
      const tier = changeTier(rev.changeKind);
      return (
        <li
          class="rev"
          id={revAnchor(rev.sha)}
          data-noise={tier === "noise" ? "" : undefined}
          data-tier={tier}
        >
          <div class="rev__head">
            <time class="mono muted" datetime={rev.date}>
              {formatDate(rev.date)}
            </time>
            <span class="pill" data-kind={rev.changeKind}>
              {CHANGE_KIND_LABEL[rev.changeKind]}
            </span>
            <span class="rev__delta mono" data-sign={rev.charDelta >= 0 ? "+" : "-"}>
              {signedDelta(rev.charDelta)}
            </span>
          </div>
          {rev.summary && <p class="rev__summary">{rev.summary}</p>}
          {rev.summary && <ModelNote model={rev.model} />}
          {prev ? (
            <details class="rev__diff">
              <summary>View diff</summary>
              <DiffView before={prev.body} after={rev.body} />
            </details>
          ) : (
            <p class="muted rev__first">First tracked revision.</p>
          )}
          <a
            class="rev__sha mono muted"
            href={`https://github.com/ANUcybernetics/aps-ai-tracker/commit/${rev.sha}`}
            rel="noopener"
            aria-label="View this capture's commit on GitHub"
          >
            {rev.sha.slice(0, 7)}
          </a>
        </li>
      );
    })
  }
  </ol>
</div>

<style>
  .revs-wrap {
    display: flex;
    flex-direction: column;
  }

  /* The toggle sits below the list; the list keeps its natural order above. */
  .revs-toggle {
    order: 2;
    margin-block-start: var(--space-3);
    font-size: 0.85rem;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .revs-toggle label {
    cursor: pointer;
  }

  .revs {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rev {
    position: relative;
    border-bottom: 1px solid var(--border);
    padding-block: var(--space-3);
  }

  /* Scrape noise is hidden by default so the real edit history reads clean;
     the checkbox reveals it. :has() keeps this CSS-only and independent of
     DOM order. */
  .rev[data-noise] {
    display: none;
  }

  .revs-wrap:has(#show-noise-revs:checked) .rev[data-noise] {
    display: list-item;
  }

  .rev__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }

  .rev[data-tier="substance"] .pill {
    background: var(--accent-wash);
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  .rev[data-tier="noise"] .pill,
  .rev[data-tier="unclassified"] .pill {
    border-style: dashed;
    color: var(--muted);
  }

  .rev__summary {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    max-inline-size: var(--measure);
    text-wrap: pretty;
  }

  .rev__delta {
    margin-inline-start: auto;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .rev__delta[data-sign="+"] {
    color: var(--ok);
  }

  .rev__delta[data-sign="-"] {
    color: var(--del-text);
  }

  .rev__first {
    margin-block: var(--space-2) 0;
    font-size: 0.85rem;
  }

  .rev__diff {
    margin-block-start: var(--space-2);
  }

  .rev__diff summary {
    cursor: pointer;
    color: var(--muted);
    font-size: 0.85rem;
    width: max-content;
  }

  .rev__sha {
    position: absolute;
    inset-inline-end: 0;
    inset-block-end: var(--space-3);
    font-size: var(--text-xs);
    text-decoration: none;
  }

  .rev__sha:hover,
  .rev__sha:focus-visible {
    color: var(--accent-ink);
    text-decoration: underline;
  }
</style>
