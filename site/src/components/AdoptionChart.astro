---
// A small step chart of one policy concept's adoption over time: the share of
// tracked statements carrying it at the end of each month, with the policy's
// own milestones as vertical rules. Built at build time as inline SVG, so it
// needs no JavaScript; the table underneath is the accessible reading of the
// same numbers.
interface Props {
  id: string;
  label: string;
  months: string[];
  counts: number[];
  tracked: number[];
  milestones: { date: string; label: string }[];
  // Optional: the latest tracked/count figures are also drawn as a headline.
  headline?: boolean;
}

const { id, label, months, counts, tracked, milestones, headline = true } = Astro.props;

const W = 320;
const H = 120;
const PAD = { top: 14, right: 10, bottom: 22, left: 30 };
const innerW = W - PAD.left - PAD.right;
const innerH = H - PAD.top - PAD.bottom;

const pct = months.map((_, i) => (tracked[i] ? (100 * counts[i]) / tracked[i] : 0));
const x = (i: number) => PAD.left + (innerW * (i + 0.5)) / months.length;
const y = (v: number) => PAD.top + innerH * (1 - v / 100);

// Step path: hold each month's value across its band.
const band = innerW / months.length;
let d = "";
months.forEach((_, i) => {
  const x0 = PAD.left + band * i;
  const yy = y(pct[i]);
  d += i === 0 ? `M${x0.toFixed(1)},${yy.toFixed(1)}` : ` L${x0.toFixed(1)},${yy.toFixed(1)}`;
  d += ` L${(x0 + band).toFixed(1)},${yy.toFixed(1)}`;
});
const area = `${d} L${(PAD.left + innerW).toFixed(1)},${y(0).toFixed(1)} L${PAD.left.toFixed(1)},${y(0).toFixed(1)} Z`;

// Milestones that fall inside the charted range, positioned by day within month.
const first = months[0];
const last = months.at(-1) ?? first;
const inRange = milestones.filter((m) => m.date.slice(0, 7) >= first && m.date.slice(0, 7) <= last);
const milestoneX = (date: string) => {
  const idx = months.indexOf(date.slice(0, 7));
  const day = Number(date.slice(8, 10)) || 1;
  return PAD.left + band * (idx + (day - 1) / 31);
};

const latest = pct.at(-1) ?? 0;
const latestCount = counts.at(-1) ?? 0;
const latestTracked = tracked.at(-1) ?? 0;

// Sparse x labels: first, last and (if room) the January in between.
const xLabels = months
  .map((m, i) => ({ m, i }))
  .filter(({ m, i }) => i === 0 || i === months.length - 1 || m.endsWith("-01"));
const monthLabel = (m: string) =>
  new Date(Number(m.slice(0, 4)), Number(m.slice(5, 7)) - 1, 1).toLocaleString("en-AU", {
    month: "short",
    year: "2-digit",
  });
const titleId = `${id}-title`;
const descId = `${id}-desc`;
---

<figure class="adopt">
  <figcaption class="adopt__cap">
    <span class="adopt__label">{label}</span>
    {
      headline && (
        <span class="adopt__now mono">
          {latestCount}/{latestTracked} · {Math.round(latest)}%
        </span>
      )
    }
  </figcaption>
  <svg
    class="adopt__svg"
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-labelledby={titleId}
    aria-describedby={descId}
  >
    <title id={titleId}>{label}, share of tracked statements by month</title>
    <desc id={descId}>
      Rises from {Math.round(pct[0] ?? 0)}% in {monthLabel(first)} to {Math.round(latest)}% in{" "}
      {monthLabel(last)}. Figures in the table below.
    </desc>
    {
      [0, 50, 100].map((v) => (
        <g>
          <line
            x1={PAD.left}
            x2={PAD.left + innerW}
            y1={y(v)}
            y2={y(v)}
            class="adopt__grid"
          />
          <text x={PAD.left - 4} y={y(v) + 3} class="adopt__tick" text-anchor="end">
            {v}%
          </text>
        </g>
      ))
    }
    {
      inRange.map((m) => (
        <line
          x1={milestoneX(m.date)}
          x2={milestoneX(m.date)}
          y1={PAD.top - 4}
          y2={PAD.top + innerH}
          class="adopt__milestone"
        >
          <title>{m.label}</title>
        </line>
      ))
    }
    <path d={area} class="adopt__area" />
    <path d={d} class="adopt__line" />
    {
      xLabels.map(({ m, i }) => (
        <text
          x={x(i)}
          y={H - 6}
          class="adopt__tick"
          text-anchor={i === 0 ? "start" : i === months.length - 1 ? "end" : "middle"}
        >
          {monthLabel(m)}
        </text>
      ))
    }
  </svg>
  <details class="adopt__table">
    <summary>Figures</summary>
    <table>
      <thead>
        <tr><th scope="col">Month</th><th scope="col">Statements</th><th scope="col">Tracked</th></tr>
      </thead>
      <tbody>
        {
          months.map((m, i) => (
            <tr>
              <td>{monthLabel(m)}</td>
              <td>{counts[i]}</td>
              <td>{tracked[i]}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
</figure>

<style>
  .adopt {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .adopt__cap {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .adopt__label {
    font-weight: 600;
  }

  .adopt__now {
    color: var(--accent-ink);
    white-space: nowrap;
  }

  .adopt__svg {
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }

  .adopt__grid {
    stroke: var(--border);
    stroke-width: 1;
  }

  .adopt__tick {
    font-family: var(--font-mono);
    font-size: 8px;
    fill: var(--muted);
  }

  .adopt__milestone {
    stroke: var(--border-strong);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }

  .adopt__area {
    fill: var(--accent-wash);
  }

  .adopt__line {
    fill: none;
    stroke: var(--accent-ink);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .adopt__table summary {
    cursor: pointer;
    font-size: var(--text-xs);
    color: var(--muted);
    width: max-content;
  }

  .adopt__table table {
    margin-block-start: var(--space-2);
    font-size: var(--text-xs);
    border-collapse: collapse;
  }

  .adopt__table th,
  .adopt__table td {
    text-align: start;
    padding: 0.15rem 0.6rem 0.15rem 0;
    border-block-end: 1px solid var(--border);
  }
</style>
