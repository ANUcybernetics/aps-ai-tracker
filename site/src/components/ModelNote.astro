---
// Muted inline provenance note for a model-written sentence: which Claude
// model read the diff and wrote the summary next to it. Renders nothing when
// no model is recorded (e.g. a cache entry classified by rule, not by Claude).
interface Props {
  model: string | null;
}

const { model } = Astro.props;

const MODEL_LABEL: Record<string, string> = {
  "claude-opus-5-5": "Claude Opus 5.5",
  "claude-opus-5": "Claude Opus 5",
  "claude-sonnet-5": "Claude Sonnet 5",
};

const label = model ? (MODEL_LABEL[model] ?? model) : null;
---

{
  label && (
    <span
      class="model-note"
      title="Written by a language model; check it against the text"
    >
      read by {label}
    </span>
  )
}
