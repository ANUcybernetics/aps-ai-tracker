{
  "name": "aps-ai-tracker-site",
  "version": "0.0.0",
  "private": true,
  "description": "Timeline + similarity explorer for Australian Government AI transparency statements",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "atproto:publish": "tsx scripts/atproto-publish.ts",
    "atproto:lexicon": "tsx scripts/publish-lexicon.ts",
    "atproto:profile": "tsx scripts/atproto-profile.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.2",
    "@atproto/api": "^0.30.0",
    "@atproto/common-web": "0.5.16",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.5",
    "diff-match-patch": "^1.0.5",
    "marked": "^18.1.3",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "pnpm": ">=11"
  }
}
