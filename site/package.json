{
  "name": "aps-ai-tracker-site",
  "version": "0.0.0",
  "private": true,
  "description": "Timeline + similarity explorer for Australian Government AI transparency statements",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "atproto:publish": "tsx scripts/atproto-publish.ts",
    "atproto:lexicon": "tsx scripts/publish-lexicon.ts",
    "atproto:profile": "tsx scripts/atproto-profile.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@atproto/api": "^0.20.42",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.2.8",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "diff-match-patch": "^1.0.5",
    "marked": "^18.0.11",
    "svelte": "^5.56.10"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^26.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "pnpm": ">=11"
  }
}
