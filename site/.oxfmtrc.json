{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "astro": { "compressHTML": "html" },
  "svelte": true,
  "ignorePatterns": ["src/generated/**", "dist/**", ".astro/**"],
  "overrides": [
    {
      "files": ["*.md"],
      "options": {
        "proseWrap": "always",
        "printWidth": 80
      }
    }
  ]
}
